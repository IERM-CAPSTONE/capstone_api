// Prisma schema for IERM (Intelligent Exam Room Management)
// - Auth/Role/User
// - Identity verification (CCCD + Face)
// - Exam scheduling + check-in/out
// - Tickets/notifications/devices


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Stores system roles (Admin, ExamOfficer, Proctor, Student, ...)
model Role {
  id         Int     @id @default(autoincrement())
  roleName   String  @unique
  users      User[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum UserStatus {
  ACTIVE
  INACTIVE
}
/// Stores user accounts for all actors in the system (Admin/ExamOfficer/Proctor/Student)
model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  fullName         String?
  username         String?  @unique
  code             String?  // MSSV or teacher's code
  avatarUrl        String?
  isActive         Boolean  @default(true)
  isEmailVerified  Boolean  @default(false)
  status           UserStatus @default(ACTIVE)

  roleId           Int?
  role             Role?    @relation(fields: [roleId], references: [id])

  examCode         ExamCode[] @relation("examCodeUsedBy")

  /// 1-1 identity profile (CCCD + face enrollment summary)
  identities       Identity?

  /// Student's exam registrations/attendance
  studentExams     StudentExam[]

  /// Ticketing
  reportedTickets  IssueTicket[] @relation("reporter")
  assignedTickets  IssueTicket[] @relation("assignee")

  /// Proctor application (teacher registers preferred shifts)
  proctorApplications ProctorApplication[] @relation("teacherApplications")

  /// Proctor được phân công coi thi
  proctorAssignments ProctorAssignment[] @relation("proctorAssignments")

  /// Notifications
  notificationsSent Notification[] @relation("from")
  notificationsReceived Notification[] @relation("to")

  /// Exam session assignments (back-relations for named relations)
  proctorSessions  ExamSession[] @relation("proctor")
  hallInvigilatorSessions ExamSession[] @relation("hallInvigilator")

  /// Device registration (admin who registered device)
  registeredDevices Device[] @relation("deviceRegisteredBy")

  /// Exam code audit (who generated codes)
  createdExamCodes ExamCode[] @relation("examCodeCreator")

  /// Who created attachments
  uploadedAttachments Attachment[] @relation("attachmentUploader")

  /// Assignment history audit
  proctorAssignmentsMade ProctorAssignment[] @relation("assignmentCreator")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Stores identity verification info (CCCD images + extracted OCR + face embedding)
/// Used mainly during enrollment / re-enrollment; in exams, face scan compares to activeVector
model Identity {
  id            Int     @id @default(autoincrement())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id])

  /// Optional raw images (can be stored in Cloudinary/S3 URL)
  faceImage     String?
  frontCCCD     String?
  backCCCD      String?

  /// OCR / extracted fields from CCCD (JSON for flexibility)
  extractedData Json?

  /// Is identity verified by exam officer/admin
  isValid       Boolean @default(false)

  /// Active face embedding used for recognition
  activeVector    Json?

  /// Enrollment history (multi-enroll support)
  enrollments   FaceEnrollment[]

  /// Student exams using this identity snapshot
  studentExams  StudentExam[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Stores exam room information (room number, capacity, etc.)
model ExamRoom {
  id          Int     @id @default(autoincrement())
  roomNumber  Int
  floorArea   Int?
  capacity    Int?
  examSessions ExamSession[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

