// Prisma StudentExam Model

/// Junction table: which student belongs to which exam session part
model StudentExamPart {
  id String @id @default(uuid())

  studentExamId String
  studentExam   StudentExam? @relation(fields: [studentExamId], references: [id])

  isInRoom    Boolean   @default(false)
  isCheckedIn Boolean   @default(false)
  checkInTime DateTime?

  examType   ExamType
  isSubmit   Boolean   @default(false)
  submitTime DateTime?

  isSign   Boolean   @default(false)
  signTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentExamId, examType])
  @@index([studentExamId])
}
