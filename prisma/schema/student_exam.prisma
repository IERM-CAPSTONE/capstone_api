// Prisma StudentExam Model

/// Junction table: which student belongs to which exam session
model StudentExam {
    id String @id @default(uuid())

    examId String
    exam   ExamSession @relation(fields: [examId], references: [id])

    studentId String
    student   User   @relation(fields: [studentId], references: [id])

    seatNumber Int?
    status     StudentExamStatus @default(CHECKEDIN)

    /// Optional link to identity snapshot used during check-in
    identityId String?
    identity   Identity? @relation(fields: [identityId], references: [id])

    isMatched    Boolean   @default(false)
    checkinTime  DateTime?
    checkoutTime DateTime?

    /// Admin/proctor can invalidate a record if fraud is detected
    isValid Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([examId, studentId])
    @@index([studentId])
    @@index([examId])
}
