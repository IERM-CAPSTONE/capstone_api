// Prisma StudentExam Model

/// Junction table: which student belongs to which exam session
model StudentExam {
  id String @id @default(uuid())

  examSessionId String
  examSession   ExamSession @relation(fields: [examSessionId], references: [id])

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  seatNumber Int?

  status          StudentExamStatus @default(REGISTERED)
  currentLocation String?
  identityId      String?
  isMatched       Boolean           @default(false)
  checkinTime     DateTime?
  checkoutTime    DateTime?
  isValid         Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityHistories ActivityHistory[]
  parts             StudentExamPart[]

  @@unique([examSessionId, studentId])
  @@index([studentId])
  @@index([examSessionId])
}
