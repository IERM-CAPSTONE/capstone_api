/// Junction table: which student belongs to which exam session
model StudentExam {
  id                String            @id @default(uuid())
  studentId         String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  examSessionId     String
  checkinTime       DateTime?
  checkoutTime      DateTime?
  currentLocation   String?
  identityId        String?
  isMatched         Boolean           @default(false)
  isValid           Boolean           @default(true)
  status            StudentExamStatus @default(REGISTERED)
  seatNumber        String?
  stt               Int?
  examSession       ExamSession       @relation(fields: [examSessionId], references: [id])
  student           User              @relation(fields: [studentId], references: [id])
  activityHistories ActivityHistory[]
  parts             StudentExamPart[]

  @@unique([examSessionId, studentId])
  @@index([studentId])
  @@index([examSessionId])
}
