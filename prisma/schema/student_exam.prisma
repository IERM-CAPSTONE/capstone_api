/// Junction table: which student belongs to which exam session
model StudentExam {
  id                String            @id @default(uuid())
  studentId         String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  examSessionId     String
  seatNumber        String?
  stt               Int?
  seatPosition      String?
  examSession       ExamSession       @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  student           User              @relation(fields: [studentId], references: [id])
  seat              ExamSeat?         @relation(fields: [seatPosition], references: [id])
  activityHistories ActivityHistory[]
  parts             StudentExamPart[]

  @@unique([examSessionId, studentId])
  @@index([studentId])
  @@index([examSessionId])
  @@index([seatPosition])
}
