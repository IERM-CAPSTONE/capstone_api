// Prisma User Activity Model
// Stores audit logs for user-related actions

model UserActivity {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation("userActivities", fields: [userId], references: [id], onDelete: Cascade)
    type      String // e.g., "ACCOUNT_CREATED", "ACCOUNT_UPDATED", "ACCOUNT_LOCKED", "ACCOUNT_UNLOCKED"
    details   String? // Description of the action
    performer String // Name or code of the person who performed the action
    timestamp DateTime @default(now())

    @@index([userId])
}
