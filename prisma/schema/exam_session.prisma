/// Represents a concrete exam session for a subject in a room at a given time
model ExamSession {
  id                String  @id @default(uuid())
  examRoomId        String?
  /// Assigned staff
  proctorId         String?
  hallInvigilatorId String?
  hallInvigilator   User?   @relation("hallInvigilator", fields: [hallInvigilatorId], references: [id])

  subjectCode   String?
  examOpenTime  DateTime?
  examCloseTime DateTime?
  examCode      String?
  openCode      String?
  status        ExamSessionStatus @default(Scheduled)
  examType      ExamType[]
  semester      String?
  note          String?
  isArchived    Boolean           @default(false)

  /// Attendance/registration list for this session
  studentExams StudentExam[]

  /// Seat layout for this session
  examSeats ExamSeat[]

  /// Locks layout editing after import
  hasStudentsImported Boolean @default(false)

  /// Related tickets/issues during this session
  tickets IssueTicket[]

  /// Assignment history/audit
  assignments ProctorAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examRoomId])
  @@index([proctorId])
  @@index([hallInvigilatorId])
  @@index([subjectCode])
  @@index([examOpenTime, examCloseTime])
}
