/// Represents a concrete exam session for a subject in a room at a given time
model ExamSession {
  id                String              @id @default(uuid())
  examRoomId        String?
  /// Assigned staff
  proctorId         String?
  hallInvigilatorId String?
  subjectCode       String?
  examOpenTime      DateTime?
  examCloseTime     DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  status            ExamSessionStatus   @default(Draft)
  examType          ExamType?
  examCode          String?
  openCode          String?
  note                String?
  hasStudentsImported Boolean           @default(false)
  semesterId          String?
  campus            Campus?
  examParts         ExamPart[]
  semester          Semester?           @relation(fields: [semesterId], references: [id])
  studentExams      StudentExam[]
  examSeats         ExamSeat[]
  examRoom          ExamRoom?           @relation(fields: [examRoomId], references: [id])
  proctor           User?               @relation("proctor", fields: [proctorId], references: [id])
  hallInvigilator   User?               @relation("hallInvigilator", fields: [hallInvigilatorId], references: [id])
  tickets           IssueTicket[]
  assignments       ProctorAssignment[]

  @@index([examRoomId])
  @@index([proctorId])
  @@index([hallInvigilatorId])
  @@index([subjectCode])
  @@index([semesterId])
  @@index([campus])
  @@index([examOpenTime, examCloseTime])
}
