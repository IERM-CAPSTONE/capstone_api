/// Stores registered devices (camera/check-in tablet/etc.) used in exam rooms
model Device {
  id           String           @id @default(uuid())
  name         String
  serial       String           @unique
  location     String?
  registeredBy String
  metadata     Json?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  admin        User             @relation("deviceRegisteredBy", fields: [registeredBy], references: [id])
  enrollments  FaceEnrollment[]

  @@index([registeredBy])
}
