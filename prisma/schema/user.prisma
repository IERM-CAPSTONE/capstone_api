/// Stores user accounts for all actors in the system (Admin/ExamOfficer/Proctor/Student)
model User {
  id                      String               @id @default(uuid())
  email                   String?              @unique
  fullName                String?
  code                    String?              @unique
  avatarUrl               String?
  isActive                Boolean              @default(true)
  role                    Role?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  lastAssignedAt          DateTime?
  campus                  Campus?
  username                String?              @unique
  identities              Identity?
  studentExams            StudentExam[]
  reportedTickets         IssueTicket[]        @relation("reporter")
  assignedTickets         IssueTicket[]        @relation("assignee")
  proctorApplications     ProctorApplication[] @relation("teacherApplications")
  proctorAssignments      ProctorAssignment[]  @relation("proctorAssignments")
  notificationsSent       Notification[]       @relation("notificationFrom")
  notificationsReceived   Notification[]       @relation("notificationTo")
  pushTokens              PushToken[]          @relation("userPushTokens")
  proctorSessions         ExamSession[]        @relation("proctor")
  hallInvigilatorSessions ExamSession[]        @relation("hallInvigilator")
  ownedDevices            Device[]             @relation("deviceOwner")
  deviceApplications      DeviceApplication[]  @relation("deviceApplicationRegisteredBy")
  deviceApprovals         DeviceApplication[]  @relation("deviceApplicationApprovedBy")
  proctorAssignmentsMade  ProctorAssignment[]  @relation("assignmentCreator")

  @@index([role])
  @@index([campus])
}
