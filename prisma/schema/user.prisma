/// Stores user accounts for all actors in the system (Admin/ExamOfficer/Proctor/Student)
model User {
  id                      String               @id @default(uuid())
  email                   String?              @unique
  fullName                String?
  code                    String?              @unique
  avatarUrl               String?
  isActive                Boolean              @default(true)
  role                    Role?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  campus                  Campus?
  username                String?              @unique
  identities              Identity?
  studentExams            StudentExam[]
  reportedTickets         IssueTicket[]        @relation("reporter")
  assignedTickets         IssueTicket[]        @relation("assignee")
  proctorApplications     ProctorApplication[] @relation("teacherApplications")
  proctorAssignments      ProctorAssignment[]  @relation("proctorAssignments")
  notificationsSent       Notification[]       @relation("notificationFrom")
  proctorSessions         ExamSession[]        @relation("proctor")
  hallInvigilatorSessions ExamSession[]        @relation("hallInvigilator")
  registeredDevices       Device[]             @relation("deviceRegisteredBy")
  proctorAssignmentsMade  ProctorAssignment[]  @relation("assignmentCreator")

  @@index([role])
  @@index([campus])
}
