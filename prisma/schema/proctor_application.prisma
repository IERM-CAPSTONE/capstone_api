/// Teachers apply for invigilation shifts (preferred date/type/shift)
model ProctorApplication {
  id                  String                    @id @default(uuid())
  teacherId           String
  targetTeacherId     String?
  examSessionId       String?
  targetExamSessionId String?
  preferredShift      PreferredShift
  preferredType       PreferredType
  preferredDate       DateTime?
  notes               String?
  status              ProctorApplicationStatus @default(PENDING)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  teacher             User                      @relation("teacherApplications", fields: [teacherId], references: [id])
  targetTeacher       User?                     @relation("targetTeacherApplications", fields: [targetTeacherId], references: [id])
  examSession         ExamSession?              @relation("sourceExamSessionApplications", fields: [examSessionId], references: [id])
  targetExamSession   ExamSession?              @relation("targetExamSessionApplications", fields: [targetExamSessionId], references: [id])

  @@index([teacherId])
  @@index([targetTeacherId])
  @@index([examSessionId])
  @@index([targetExamSessionId])
}
