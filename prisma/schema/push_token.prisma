/// Stores FCM push tokens per user/device for OS-level push notifications
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  deviceId   String?
  token      String   @unique
  platform   String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation("userPushTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([isActive])
}
