// Prisma Enums
// All enum definitions for the IERM system

/// User roles in the system
enum Role {
  ADMIN
  EXAM_OFFICER
  PROCTOR
  STUDENT
  IT_SUPPORT
}

enum Campus {
  HCM
  HN
  DN
  QN
  CT
}

/// Student exam attendance status
enum StudentExamStatus {
  REGISTERED
  CHECKEDIN
  CHECKEDOUT
  MOVED
  REMOVED
}

/// Issue ticket status
enum IssueStatus {
  PENDING
  CLOSED
  IN_PROGRESS
  SOLVED
  OPEN
}

/// Preferred shift for proctor applications
enum PreferredShift {
  MORNING
  AFTERNOON
}

/// Preferred type for proctor applications
enum PreferredType {
  ROOM
  HALL
}

/// Proctor application status
enum ProctorApplicationStatus {
  APPROVED
  PENDING
  REJECTED
  CANCELED
}

/// Assignment status for proctor assignments
enum AssignmentStatus {
  ASSIGNED
  CANCELLED
}

/// Exam room status
enum ExamRoomStatus {
  Available
  Occupied
  Maintenance
  Exam_Ongoing
  For_Exam
}

/// Exam session status
enum ExamSessionStatus {
  Ongoing
  Ended
  Scheduled
}

/// Activity types for auditing student exam actions
enum ActivityType {
  CHECKED_IN
  MOVED
}

/// Type of exam part
enum ExamType {
  PE
  TE
  S
  L
  R
  W
  FE
  GV
  MC
}
