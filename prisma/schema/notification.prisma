/// In-app notifications, supports user-to-user messaging
model Notification {
  id        String   @id @default(uuid())
  toUserId  String
  fromId    String?
  title     String
  message   String
  channel   String?
  meta      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  toUser    User     @relation("notificationTo", fields: [toUserId], references: [id])
  from      User?    @relation("notificationFrom", fields: [fromId], references: [id])

  @@index([toUserId])
  @@index([fromId])
}
