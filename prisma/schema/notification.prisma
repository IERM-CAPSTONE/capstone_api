/// Notification messages from users to exam rooms (in-app/email/sms as channels)
model Notification {
  id        String   @id @default(uuid())
  toId      String
  fromId    String?
  title     String
  message   String
  channel   String?
  meta      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  to        ExamRoom @relation(fields: [toId], references: [id])
  from      User?    @relation("notificationFrom", fields: [fromId], references: [id])

  @@index([toId])
  @@index([fromId])
}
