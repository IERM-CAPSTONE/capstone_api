/// Stores exam room information (room number, capacity, etc.)
model ExamRoom {
  id            String         @id @default(uuid())
  roomNumber    String
  capacity      Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  status        ExamRoomStatus @default(Available)
  max_columns   Int?
  max_rows      Int?
  total_seats   Int?
  campus        Campus?
  examSessions  ExamSession[]
  notifications Notification[]

  @@unique([roomNumber, campus])
  @@index([campus])
}
