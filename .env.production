# Production Environment
NODE_ENV=production

# RabbitMQ Configuration
RABBITMQ_URL=amqp://admin:admin123@rabbitmq-prod:5672
RABBITMQ_HOST=rabbitmq-prod
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_secure_password

# API Configuration
API_PORT=3000

# Background Worker Configuration
BACKGROUND_PORT=3002

# Database Configuration
DATABASE_URL="postgresql://postgres:your_secure_db_password@db-prod:5432/capstone_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET=your_production_access_secret
JWT_REFRESH_SECRET=your_production_refresh_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback
