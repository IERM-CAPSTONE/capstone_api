# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=capstone_db
DB_PORT_EXTERNAL=5432

# RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_PORT_EXTERNAL=5672
RABBITMQ_UI_PORT_EXTERNAL=15672

# API Configuration
API_PORT_EXTERNAL=3000

# Background Worker Configuration
BACKGROUND_PORT_EXTERNAL=3001

# JWT Authentication (Secrets - KEEP PRIVATE)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Full URLs (For local development outside Docker)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT_EXTERNAL}/${DB_NAME}?schema=public"
RABBITMQ_URL="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:${RABBITMQ_PORT_EXTERNAL}"
