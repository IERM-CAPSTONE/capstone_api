{
  "name": "capstone-app",
  "version": "0.0.1",
  "description": "Face Authentication Capstone Project - Monorepo",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "build:api": "prisma generate && nest build app_api",
    "build:background": "prisma generate && nest build app_background",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:api": "nest start app_api",
    "start:background": "nest start app_background",
    "start:dev:api": "nest start app_api --watch",
    "start:dev:background": "nest start app_background --watch",
    "start:dev:all": "concurrently \"npm run start:dev:api\" \"npm run start:dev:background\" --names \"API,BG\" --prefix-colors \"blue,green\"",
    "start:debug:api": "nest start app_api --debug --watch",
    "start:debug:background": "nest start app_background --debug --watch",
    "start:prod:api": "node dist/apps/app_api/main",
    "start:prod:background": "node dist/apps/app_background/main",
    "start:prod:all": "concurrently \"npm run start:prod:api\" \"npm run start:prod:background\" --names \"API,BG\" --prefix-colors \"blue,green\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/app_api/test/jest-e2e.json",
    "db:seed": "npx ts-node prisma/seed-ready.ts",
    "db:seed:legacy": "npx ts-node prisma/seed.ts",
    "db:seed:comprehensive": "npx ts-node prisma/seed-comprehensive.ts",
    "db:reset": "npx prisma migrate reset --force",
    "db:migrate": "npx prisma migrate dev"
  },
  "prisma": {
    "seed": "ts-node prisma/seed-ready.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^10.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.21",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.4.21",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.4",
    "argon2": "^0.44.0",
    "axios": "^1.16.0",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.7.0",
    "google-auth-library": "^10.6.1",
    "javascript-lp-solver": "^1.0.3",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.3.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "pactum": "^3.9.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "collectCoverageFrom": [
      "apps/app_api/src/**/*.ts",
      "libs/**/*.ts",
      "!**/*.module.ts",
      "!**/*.spec.ts",
      "!**/*.endpoint.ts",
      "!**/*.strategy.ts",
      "!**/index.ts",
      "!**/main.ts"
    ],
    "coveragePathIgnorePatterns": [
      "node_modules",
      ".module.ts",
      "<rootDir>/libs/prisma",
      "apps/app_api/src/common",
      ".dto.ts",
      ".entity.ts",
      ".repository.ts",
      ".endpoint.ts",
      ".strategy.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/users(|/.*)$": "<rootDir>/libs/users/src/$1",
      "^@app/prisma(|/.*)$": "<rootDir>/libs/prisma/$1",
      "^@app/queue(|/.*)$": "<rootDir>/libs/queue/src/$1",
      "^@app/exam-parts(|/.*)$": "<rootDir>/libs/exam-parts/src/$1",
      "^@app/subjects(|/.*)$": "<rootDir>/libs/subjects/src/$1",
      "^@app/exam-types(|/.*)$": "<rootDir>/libs/exam-types/src/$1",
      "^@app/tickets(|/.*)$": "<rootDir>/libs/tickets/src/$1"
    }
  }
}
